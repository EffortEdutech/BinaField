{
  "$id": "https://schemas.binafield.io/sync/1.0/outbox-operation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_count": {
      "minimum": 0,
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "entity_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_attempt_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "operation_id": {
      "format": "uuid",
      "type": "string"
    },
    "operation_type": {
      "enum": [
        "EVIDENCE_UPLOAD_INIT",
        "EVIDENCE_UPLOAD_PART",
        "EVIDENCE_UPLOAD_FINALIZE",
        "SUBMISSION_ATTEMPT_SEND",
        "SYNC_ACK",
        "RECONCILIATION_RESPONSE",
        "DIAGNOSTIC_UPLOAD"
      ]
    },
    "organization_id": {
      "format": "uuid",
      "type": "string"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "state": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "RETRY_WAIT",
        "BLOCKED_DEPENDENCY",
        "RECONCILIATION_REQUIRED",
        "SUCCEEDED",
        "FAILED_FINAL",
        "CANCELLED_BY_POLICY"
      ]
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "operation_id",
    "organization_id",
    "operation_type",
    "priority",
    "state",
    "attempt_count",
    "created_at",
    "updated_at"
  ],
  "title": "SyncOutboxOperation",
  "type": "object"
}
