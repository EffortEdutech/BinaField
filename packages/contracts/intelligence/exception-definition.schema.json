{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.binafield.io/intelligence/exception-definition/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exception_key",
    "version",
    "source_metric",
    "condition",
    "threshold",
    "severity",
    "active"
  ],
  "properties": {
    "exception_key": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "source_metric": {
      "type": "string"
    },
    "condition": {
      "enum": [
        "GT",
        "GTE",
        "LT",
        "LTE",
        "EQ",
        "NEQ"
      ]
    },
    "threshold": {
      "type": "number"
    },
    "window": {
      "type": "string"
    },
    "minimum_sample": {
      "type": "integer",
      "minimum": 1
    },
    "severity": {
      "enum": [
        "INFO",
        "WARNING",
        "HIGH",
        "CRITICAL"
      ]
    },
    "message_template": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    }
  }
}
