{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.binafield.io/intelligence/query-plan/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metric_key",
    "date_from",
    "date_to"
  ],
  "properties": {
    "metric_key": {
      "type": "string"
    },
    "metric_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "date_from": {
      "type": "string",
      "format": "date-time"
    },
    "date_to": {
      "type": "string",
      "format": "date-time"
    },
    "group_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "maxItems": 4
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 20
    },
    "comparison": {
      "type": [
        "object",
        "null"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "allow_stale": {
      "type": "boolean"
    },
    "semantic_target_template_version_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
