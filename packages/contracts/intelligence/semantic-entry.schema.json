{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.binafield.io/intelligence/semantic-entry/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "semantic_key",
    "canonical_name",
    "value_type",
    "allowed_aggregations",
    "classification_default"
  ],
  "properties": {
    "semantic_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "value_type": {
      "enum": [
        "NUMERIC",
        "INTEGER",
        "BOOLEAN",
        "TEXT",
        "ENUM",
        "DATE",
        "DATETIME",
        "CURRENCY",
        "GEO",
        "DURATION"
      ]
    },
    "canonical_unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "default_analytical_role": {
      "enum": [
        "MEASURE",
        "DIMENSION",
        "ATTRIBUTE"
      ]
    },
    "allowed_aggregations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "compatible_dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "classification_default": {
      "enum": [
        "PUBLIC_OPERATIONAL",
        "INTERNAL",
        "CONFIDENTIAL",
        "PERSONAL_DATA",
        "SENSITIVE_OPERATIONAL"
      ]
    },
    "introduced_version": {
      "type": "string"
    },
    "deprecated_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "domain": {
      "type": "string"
    }
  }
}
