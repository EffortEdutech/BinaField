{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.binafield.io/intelligence/drilldown/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metric_key",
    "metric_version",
    "depth",
    "limit"
  ],
  "properties": {
    "metric_key": {
      "type": "string"
    },
    "metric_version": {
      "type": "integer",
      "minimum": 1
    },
    "depth": {
      "enum": [
        "RECORD_LIST",
        "SUBMISSION",
        "EVIDENCE"
      ]
    },
    "token": {
      "type": [
        "string",
        "null"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    }
  }
}
