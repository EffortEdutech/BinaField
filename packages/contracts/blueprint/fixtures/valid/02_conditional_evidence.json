{
  "schema": "bf-blueprint/1.0",
  "schema_version": "1.0",
  "compatibility": {
    "min_runtime_version": "1.0.0",
    "component_registry_version": "1.0.0"
  },
  "template": {
    "template_id": "tpl-demo",
    "version_id": "tv-demo-v1",
    "name": "Conditional Evidence"
  },
  "settings": {
    "locale": "en-MY",
    "on_hide": "clear"
  },
  "workflow_steps": [
    {
      "step_id": "s1",
      "title": "Context",
      "sections": [
        {
          "section_id": "sec1",
          "title": "Checks",
          "components": [
            {
              "field_id": "irrigated",
              "component": "toggle",
              "label": "Irrigated?",
              "required": true,
              "config": {},
              "analytics": {
                "enabled": true,
                "semantic_key": "farm.irrigated",
                "classification": "INTERNAL"
              }
            },
            {
              "field_id": "reason",
              "component": "paragraph",
              "label": "Reason",
              "required": false,
              "config": {
                "max_length": 500
              },
              "analytics": {
                "enabled": false
              }
            }
          ]
        }
      ]
    },
    {
      "step_id": "s2",
      "title": "Evidence",
      "sections": [
        {
          "section_id": "sec2",
          "title": "Location & Photo",
          "components": [
            {
              "field_id": "location",
              "component": "gps",
              "label": "Location",
              "required": true,
              "config": {
                "required_accuracy_m": 30
              },
              "analytics": {
                "enabled": true,
                "semantic_key": "site.location",
                "classification": "INTERNAL"
              }
            },
            {
              "field_id": "photos",
              "component": "camera",
              "label": "Photos",
              "required": true,
              "config": {
                "min_items": 1,
                "max_items": 4,
                "watermark_derivative": true
              },
              "analytics": {
                "enabled": false
              }
            }
          ]
        }
      ]
    }
  ],
  "validations": [],
  "rules": [
    {
      "rule_id": "r1",
      "when": {
        "op": "EQ",
        "field_id": "irrigated",
        "value": false
      },
      "action": "REQUIRE",
      "target_field_id": "reason",
      "message": "Explain why irrigation is unavailable."
    }
  ],
  "calculations": [],
  "submission_policy": {
    "allow_offline_submit": true,
    "require_all_required_evidence": true
  },
  "sync_policy": {
    "offline_capable": true,
    "reference_dataset_ids": []
  },
  "processing_routes": [],
  "analytics": {
    "enabled": true
  }
}
