{
  "schema": "bf-blueprint/1.0",
  "schema_version": "1.0",
  "compatibility": {
    "min_runtime_version": "1.0.0",
    "component_registry_version": "1.0.0"
  },
  "template": {
    "template_id": "tpl-demo",
    "version_id": "tv-demo-v1",
    "name": "Barcode Repeat Calculation"
  },
  "settings": {
    "locale": "en-MY",
    "on_hide": "clear"
  },
  "workflow_steps": [
    {
      "step_id": "s1",
      "title": "Assets",
      "sections": [
        {
          "section_id": "sec1",
          "title": "Assets",
          "components": [
            {
              "field_id": "asset_code",
              "component": "barcode_qr",
              "label": "Asset code",
              "required": false,
              "config": {
                "formats": [
                  "QR_CODE",
                  "CODE_128"
                ],
                "manual_fallback": true
              },
              "analytics": {
                "enabled": false
              }
            },
            {
              "field_id": "items",
              "component": "repeat_group",
              "label": "Measurements",
              "required": false,
              "config": {
                "min_items": 1,
                "max_items": 10,
                "item_label": "Reading",
                "children": [
                  {
                    "field_id": "pressure",
                    "component": "number",
                    "label": "Pressure",
                    "config": {
                      "minimum": 0
                    }
                  }
                ]
              },
              "analytics": {
                "enabled": false
              }
            },
            {
              "field_id": "total",
              "component": "computed_field",
              "label": "Total",
              "required": false,
              "config": {
                "value_type": "number",
                "calculation_id": "calc-total"
              },
              "analytics": {
                "enabled": true,
                "semantic_key": "pump.total",
                "classification": "INTERNAL"
              }
            }
          ]
        }
      ]
    }
  ],
  "validations": [],
  "rules": [],
  "calculations": [
    {
      "calculation_id": "calc-total",
      "target_field_id": "total",
      "expression": {
        "op": "ADD",
        "args": [
          {
            "literal": 1
          },
          {
            "literal": 2
          }
        ]
      }
    }
  ],
  "submission_policy": {
    "allow_offline_submit": true,
    "require_all_required_evidence": true
  },
  "sync_policy": {
    "offline_capable": true,
    "reference_dataset_ids": []
  },
  "processing_routes": [],
  "analytics": {
    "enabled": true
  }
}
