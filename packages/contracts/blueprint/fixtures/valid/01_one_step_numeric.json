{
  "schema": "bf-blueprint/1.0",
  "schema_version": "1.0",
  "compatibility": {
    "min_runtime_version": "1.0.0",
    "component_registry_version": "1.0.0"
  },
  "template": {
    "template_id": "tpl-demo",
    "version_id": "tv-demo-v1",
    "name": "One Step Numeric"
  },
  "settings": {
    "locale": "en-MY",
    "on_hide": "clear"
  },
  "workflow_steps": [
    {
      "step_id": "s1",
      "title": "Inspection",
      "sections": [
        {
          "section_id": "sec1",
          "title": "Data",
          "components": [
            {
              "field_id": "notes",
              "component": "text",
              "label": "Notes",
              "required": false,
              "config": {
                "max_length": 200
              },
              "analytics": {
                "enabled": false
              }
            },
            {
              "field_id": "yield_kg",
              "component": "number",
              "label": "Yield",
              "required": true,
              "config": {
                "minimum": 0,
                "unit": "kg"
              },
              "analytics": {
                "enabled": true,
                "semantic_key": "farm.yield_kg",
                "classification": "INTERNAL"
              }
            }
          ]
        }
      ]
    }
  ],
  "validations": [],
  "rules": [],
  "calculations": [],
  "submission_policy": {
    "allow_offline_submit": true,
    "require_all_required_evidence": true
  },
  "sync_policy": {
    "offline_capable": true,
    "reference_dataset_ids": []
  },
  "processing_routes": [],
  "analytics": {
    "enabled": true
  }
}
