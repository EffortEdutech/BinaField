{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GpsValue",
  "type": "object",
  "properties": {
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "accuracy_m": {
      "type": "number",
      "minimum": 0
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "latitude",
    "longitude",
    "accuracy_m",
    "captured_at"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.binafield.dev/bf-blueprint/1.0/components/gps.value.schema.json"
}
