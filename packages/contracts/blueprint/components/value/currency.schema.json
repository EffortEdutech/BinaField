{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CurrencyValue",
  "type": "object",
  "properties": {
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    }
  },
  "required": [
    "amount",
    "currency"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.binafield.dev/bf-blueprint/1.0/components/currency.value.schema.json"
}
