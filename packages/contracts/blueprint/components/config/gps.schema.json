{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GpsConfig",
  "type": "object",
  "properties": {
    "required_accuracy_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "geofence": {
      "type": "object",
      "required": [
        "lat",
        "lng",
        "radius_m"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "required": [],
  "additionalProperties": false,
  "$id": "https://schemas.binafield.dev/bf-blueprint/1.0/components/gps.config.schema.json"
}
