{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepeatGroupConfig",
  "type": "object",
  "properties": {
    "min_items": {
      "type": "integer",
      "minimum": 0
    },
    "max_items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "item_label": {
      "type": "string"
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "field_id",
          "component",
          "label",
          "config"
        ],
        "properties": {
          "field_id": {
            "type": "string"
          },
          "component": {
            "enum": [
              "text",
              "paragraph",
              "number",
              "integer",
              "currency",
              "numeric_stepper",
              "single_select",
              "multi_select",
              "toggle",
              "date",
              "time",
              "datetime",
              "gps",
              "camera",
              "file_attachment",
              "signature",
              "barcode_qr",
              "instruction",
              "computed_field"
            ]
          },
          "label": {
            "type": "string"
          },
          "config": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "max_items",
    "children"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.binafield.dev/bf-blueprint/1.0/components/repeat_group.config.schema.json"
}
