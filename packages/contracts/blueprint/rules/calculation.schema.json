{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.binafield.dev/bf-blueprint/1.0/calculation.schema.json",
  "type": "object",
  "required": [
    "calculation_id",
    "target_field_id",
    "expression"
  ],
  "properties": {
    "calculation_id": {
      "type": "string",
      "minLength": 1
    },
    "target_field_id": {
      "type": "string",
      "minLength": 1
    },
    "expression": {
      "$ref": "#/$defs/expression"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "type": [
                "number",
                "integer"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "field"
          ],
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "ADD",
                "SUBTRACT",
                "MULTIPLY",
                "DIVIDE",
                "MIN",
                "MAX"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
