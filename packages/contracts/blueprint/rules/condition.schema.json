{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.binafield.dev/bf-blueprint/1.0/condition.schema.json",
  "title": "BinaField Condition AST",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "op",
        "field_id",
        "value"
      ],
      "properties": {
        "op": {
          "enum": [
            "EQ",
            "NEQ",
            "GT",
            "GTE",
            "LT",
            "LTE",
            "CONTAINS"
          ]
        },
        "field_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "op",
        "field_id"
      ],
      "properties": {
        "op": {
          "enum": [
            "IS_SET",
            "IS_EMPTY"
          ]
        },
        "field_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "op",
        "conditions"
      ],
      "properties": {
        "op": {
          "enum": [
            "AND",
            "OR"
          ]
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "op",
        "condition"
      ],
      "properties": {
        "op": {
          "const": "NOT"
        },
        "condition": {
          "$ref": "#"
        }
      },
      "additionalProperties": false
    }
  ]
}
