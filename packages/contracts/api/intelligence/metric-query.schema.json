{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.binafield.io/api/intelligence/metric-query/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metric_id",
    "date_from",
    "date_to"
  ],
  "properties": {
    "metric_id": {
      "type": "string"
    },
    "date_from": {
      "type": "string",
      "format": "date-time"
    },
    "date_to": {
      "type": "string",
      "format": "date-time"
    },
    "group_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "filters": {
      "type": "object"
    },
    "comparison": {
      "type": [
        "object",
        "null"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    }
  }
}
