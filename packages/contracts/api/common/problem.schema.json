{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.binafield.io/api/common/problem/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "title",
    "status",
    "code",
    "detail",
    "correlation_id",
    "retryable"
  ],
  "properties": {
    "type": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "code": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "retryable": {
      "type": "boolean"
    },
    "field_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "metadata": {
      "type": "object"
    }
  }
}
