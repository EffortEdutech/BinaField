{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.binafield.io/api/field/bootstrap/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sync_protocol_version",
    "organization_id",
    "membership_id",
    "device_id",
    "security_policy_version",
    "cursor",
    "server_time",
    "offline_lease_expires_at"
  ],
  "properties": {
    "sync_protocol_version": {
      "const": "1.0"
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "membership_id": {
      "type": "string",
      "format": "uuid"
    },
    "device_id": {
      "type": "string",
      "format": "uuid"
    },
    "security_policy_version": {
      "type": "string"
    },
    "cursor": {
      "type": "string"
    },
    "server_time": {
      "type": "string",
      "format": "date-time"
    },
    "offline_lease_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "project_summaries": {
      "type": "array"
    },
    "assignment_packages": {
      "type": "array"
    },
    "reference_datasets": {
      "type": "array"
    }
  }
}
