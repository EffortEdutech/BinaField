{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.binafield.io/api/evidence/upload-init/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attachment_id",
    "organization_id",
    "mime_type",
    "byte_size",
    "sha256",
    "source_kind"
  ],
  "properties": {
    "attachment_id": {
      "type": "string",
      "format": "uuid"
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "mime_type": {
      "type": "string"
    },
    "byte_size": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_kind": {
      "type": "string"
    },
    "assignment_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "field_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
